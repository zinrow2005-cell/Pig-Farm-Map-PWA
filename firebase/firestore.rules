rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Allow a Google-authenticated submitter even if email_verified claim is unavailable.
    function googleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // Existing verified sign-ins retain their access; Google submissions do not
    // lose owner-only edit/audit access solely because email_verified is absent.
    function contributor() {
      return signedIn() || googleUser();
    }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    function allowedCoords(data, latKey, lngKey) {
      let lat = data.get(latKey, null);
      let lng = data.get(lngKey, null);
      return (lat == null && lng == null) ||
        (lat is number && lng is number && lat >= 21 && lat <= 27 && lng >= 118 && lng <= 123);
    }
    function validFarm(data, id) {
      return data.keys().hasAll(['uid','name','county','town','address','lat','lng','version','updatedAt','approvedSuggestionId'])
        && data.keys().hasOnly(['uid','name','county','town','address','lat','lng','version','updatedAt','approvedSuggestionId','auditDecision','auditParcelKey','approvalLockId'])
        && (!data.keys().hasAny(['auditDecision']) || data.auditDecision in ['pig','maybe'])
        && (!data.keys().hasAny(['auditParcelKey']) || (data.auditParcelKey is string && data.auditParcelKey.size() <= 160))
        && (!data.keys().hasAny(['approvalLockId']) || (data.approvalLockId is string && data.approvalLockId.size() > 0 && data.approvalLockId.size() <= 100))
        && data.uid == id && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.county is string && data.county.size() > 0 && data.county.size() <= 40
        && data.town is string && data.town.size() > 0 && data.town.size() <= 40
        && data.address is string && data.address.size() <= 220
        && data.version is int && data.version >= 1
        && data.updatedAt == request.time
        && allowedCoords(data,'lat','lng');
    }
    function validSuggestion(data) {
      return data.keys().hasAll(['farmUid','baseVersion','proposedName','proposedCounty','proposedTown','proposedAddress','proposedLat','proposedLng','note','submittedBy','submittedAt','status','reviewedBy','reviewedAt'])
        && data.keys().hasOnly(['farmUid','baseVersion','proposedName','proposedCounty','proposedTown','proposedAddress','proposedLat','proposedLng','note','submittedBy','submittedAt','status','reviewedBy','reviewedAt','parcelKey','decision'])
        && (!data.keys().hasAny(['parcelKey']) || (data.parcelKey is string && data.parcelKey.size()<=160))
        && (!data.keys().hasAny(['decision']) || data.decision in ['pig','maybe'])
        && data.farmUid is string && data.farmUid.size() > 0 && data.farmUid.size() <= 100
        && data.baseVersion is int && data.baseVersion >= 1
        && data.proposedName is string && data.proposedName.size() > 0 && data.proposedName.size() <= 150
        && data.proposedCounty is string && data.proposedCounty.size() > 0 && data.proposedCounty.size() <= 40
        && data.proposedTown is string && data.proposedTown.size() > 0 && data.proposedTown.size() <= 40
        && data.proposedAddress is string && data.proposedAddress.size() <= 220
        && data.note is string && data.note.size() <= 500
        && allowedCoords(data,'proposedLat','proposedLng');
    }
    // 管理者文件只能由專案擁有者在 Firebase Console / 受信任 Admin SDK 建立。
    // 一般使用者即使知道自己的 UID，也不能建立或修改這個角色。
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /farms/{farmId} {
      // 地址／座標公開查詢，不代表查核／核定資料同步。
      allow read: if true;
      // 管理員首次匯入只准新建，不能用舊名冊覆蓋已存在的資料。
      allow create: if admin() && !exists(/databases/$(database)/documents/deletedFarms/$(farmId)) && validFarm(request.resource.data, farmId)
        && request.resource.data.version == 1
        && request.resource.data.approvedSuggestionId == null
        // Newly approved applications require an immutable same-transaction
        // lock. Older imported farms retain their legacy create path.
        && (!farmId.matches('^submitted-.*$') || (
          request.resource.data.keys().hasAny(['approvalLockId'])
          && getAfter(/databases/$(database)/documents/farmApprovalLocks/$(request.resource.data.approvalLockId)).data.farmUid == farmId
          && ('submitted-' + getAfter(/databases/$(database)/documents/farmApprovalLocks/$(request.resource.data.approvalLockId)).data.submissionId) == farmId
        ))
        ;
      // 採納建議只能用跨文件交易，兩份資料在相同提交內一致更新。
      allow update: if admin() && validFarm(request.resource.data,farmId)
        && request.resource.data.version == resource.data.version + 1
        && ((request.resource.data.approvedSuggestionId == resource.data.approvedSuggestionId) || (request.resource.data.approvedSuggestionId is string
        && request.resource.data.approvedSuggestionId != resource.data.approvedSuggestionId
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.reviewedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.farmUid == farmId
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.baseVersion == resource.data.version
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.proposedName == request.resource.data.name
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.proposedCounty == request.resource.data.county
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.proposedTown == request.resource.data.town
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.proposedAddress == request.resource.data.address
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.proposedLat == request.resource.data.lat
        && getAfter(/databases/$(database)/documents/suggestions/$(request.resource.data.approvedSuggestionId)).data.proposedLng == request.resource.data.lng));
      // 必須在同一交易內建立不可覆寫的刪除墓碑，避免已刪場址再被初始名冊補回。
      allow delete: if admin()
        && getAfter(/databases/$(database)/documents/deletedFarms/$(farmId)).data.farmUid == farmId
        && getAfter(/databases/$(database)/documents/deletedFarms/$(farmId)).data.deletedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/deletedFarms/$(farmId)).data.lastVersion == resource.data.version;
    }
    // V3.3.91: immutable approval lock. A transaction must create its farm,
    // approve its pending application and acquire this lock together.
    // Lock IDs are deterministic in the app; the rules also bind the lock to
    // the actual submission and farm. No blanket write access is granted.
    match /farmApprovalLocks/{lockId} {
      allow get, list: if admin();
      allow create: if admin()
        && !exists(/databases/$(database)/documents/farmApprovalLocks/$(lockId))
        && request.resource.data.keys().hasAll(['lockKey','farmUid','submissionId','parcelKey','createdBy','createdAt'])
        && request.resource.data.keys().hasOnly(['lockKey','farmUid','submissionId','parcelKey','createdBy','createdAt'])
        && request.resource.data.lockKey is string && request.resource.data.lockKey.size() > 0 && request.resource.data.lockKey.size() <= 220
        && request.resource.data.parcelKey is string && request.resource.data.parcelKey.size() <= 160
        && request.resource.data.submissionId is string && request.resource.data.submissionId.size() > 0
        && request.resource.data.farmUid == ('submitted-' + request.resource.data.submissionId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!lockId.matches('^reopen-.*$') || (
          exists(/databases/$(database)/documents/farmReestablishmentReviews/$(request.resource.data.submissionId))
          && get(/databases/$(database)/documents/farmReestablishmentReviews/$(request.resource.data.submissionId)).data.newLockId == lockId
          && get(/databases/$(database)/documents/farmReestablishmentReviews/$(request.resource.data.submissionId)).data.submissionId == request.resource.data.submissionId
          && exists(/databases/$(database)/documents/deletedFarms/$(get(/databases/$(database)/documents/farmReestablishmentReviews/$(request.resource.data.submissionId)).data.priorFarmUid))
          && get(/databases/$(database)/documents/farmApprovalLocks/$(get(/databases/$(database)/documents/farmReestablishmentReviews/$(request.resource.data.submissionId)).data.priorLockId)).data.farmUid == get(/databases/$(database)/documents/farmReestablishmentReviews/$(request.resource.data.submissionId)).data.priorFarmUid
        ))
        && exists(/databases/$(database)/documents/farmSubmissions/$(request.resource.data.submissionId))
        && get(/databases/$(database)/documents/farmSubmissions/$(request.resource.data.submissionId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/farmSubmissions/$(request.resource.data.submissionId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/farmSubmissions/$(request.resource.data.submissionId)).data.reviewedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/farms/$(request.resource.data.farmUid)).data.approvalLockId == lockId
        && getAfter(/databases/$(database)/documents/farms/$(request.resource.data.farmUid)).data.auditParcelKey == request.resource.data.parcelKey;
      allow update, delete: if false;
    }
    // V3.3.93: immutable, administrator-only lineage review. Historical deletion
    // and first approval lock must both exist; it cannot resurrect the old ID.
    match /farmReestablishmentReviews/{submissionId} {
      allow get, list: if admin();
      allow create: if admin()
        && !exists(/databases/$(database)/documents/farmReestablishmentReviews/$(submissionId))
        && request.resource.data.keys().hasAll(['submissionId','priorFarmUid','priorLockId','newLockId','reason','adminUid','reviewedAt'])
        && request.resource.data.keys().hasOnly(['submissionId','priorFarmUid','priorLockId','newLockId','reason','adminUid','reviewedAt'])
        && request.resource.data.submissionId == submissionId
        && request.resource.data.priorFarmUid is string && request.resource.data.priorFarmUid.size() > 0 && request.resource.data.priorFarmUid.size() <= 100
        && request.resource.data.priorLockId is string && request.resource.data.priorLockId.size() > 0 && request.resource.data.priorLockId.size() <= 100
        && request.resource.data.newLockId == ('reopen-' + request.resource.data.priorLockId)
        && request.resource.data.newLockId.size() <= 100
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && exists(/databases/$(database)/documents/deletedFarms/$(request.resource.data.priorFarmUid))
        && exists(/databases/$(database)/documents/farmApprovalLocks/$(request.resource.data.priorLockId))
        && get(/databases/$(database)/documents/farmApprovalLocks/$(request.resource.data.priorLockId)).data.farmUid == request.resource.data.priorFarmUid
        && exists(/databases/$(database)/documents/farmSubmissions/$(submissionId))
        && get(/databases/$(database)/documents/farmSubmissions/$(submissionId)).data.status == 'pending'
        && get(/databases/$(database)/documents/farmSubmissions/$(submissionId)).data.parcelKey == get(/databases/$(database)/documents/farmApprovalLocks/$(request.resource.data.priorLockId)).data.parcelKey;
      allow update, delete: if false;
    }
    match /deletedFarms/{farmId} {
      allow read: if true;
      allow create: if admin()
        && !exists(/databases/$(database)/documents/deletedFarms/$(farmId))
        && request.resource.data.keys().hasAll(['farmUid','name','deletedBy','deletedAt','lastVersion'])
        && request.resource.data.keys().hasOnly(['farmUid','name','deletedBy','deletedAt','lastVersion'])
        && request.resource.data.farmUid == farmId
        && request.resource.data.name is string && request.resource.data.name.size() <= 150
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.lastVersion is int
        && exists(/databases/$(database)/documents/farms/$(farmId))
        && !existsAfter(/databases/$(database)/documents/farms/$(farmId));
      allow update, delete: if false;
    }
    match /farmSubmissions/{id} {
      // Keep read access consistent with create: a Google account without an
      // email_verified claim can still read ONLY its own application.
      // Ordinary users must query with where('submittedBy','==',auth.uid).
      allow get: if admin() || (googleUser() && resource.data.submittedBy == request.auth.uid);
      allow list: if admin() || (googleUser() && resource.data.submittedBy == request.auth.uid);
      allow create: if googleUser()
        && request.resource.data.keys().hasAll(['proposedName','proposedCounty','proposedTown','proposedAddress','proposedLat','proposedLng','decision','parcelKey','note','submittedBy','submittedAt','status','reviewedBy','reviewedAt'])
        && request.resource.data.keys().hasOnly(['proposedName','proposedCounty','proposedTown','proposedAddress','proposedLat','proposedLng','decision','parcelKey','note','submittedBy','submittedAt','status','reviewedBy','reviewedAt'])
        && request.resource.data.proposedName is string && request.resource.data.proposedName.size() > 0 && request.resource.data.proposedName.size() <= 150
        && request.resource.data.proposedCounty is string && request.resource.data.proposedCounty.size() > 0 && request.resource.data.proposedCounty.size() <= 40
        && request.resource.data.proposedTown is string && request.resource.data.proposedTown.size() > 0 && request.resource.data.proposedTown.size() <= 40
        && request.resource.data.proposedAddress is string && request.resource.data.proposedAddress.size() <= 220
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.decision in ['pig','maybe']
        && request.resource.data.parcelKey is string && request.resource.data.parcelKey.size() <= 160
        && allowedCoords(request.resource.data,'proposedLat','proposedLng')
        && request.resource.data.proposedLat != null
        && request.resource.data.submittedBy == request.auth.uid && request.resource.data.submittedAt == request.time
        && request.resource.data.status == 'pending' && request.resource.data.reviewedBy == null && request.resource.data.reviewedAt == null;
      allow update: if admin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'rejected' || (
          getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.keys().hasAny(['approvalLockId'])
          && getAfter(/databases/$(database)/documents/farmApprovalLocks/$(getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.approvalLockId)).data.submissionId == id
          && getAfter(/databases/$(database)/documents/farmApprovalLocks/$(getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.approvalLockId)).data.farmUid == ('submitted-' + id)
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.name == resource.data.proposedName
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.auditDecision == resource.data.decision
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.auditParcelKey == resource.data.get('parcelKey','')
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.county == resource.data.proposedCounty
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.town == resource.data.proposedTown
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.address == resource.data.proposedAddress
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.lat == resource.data.proposedLat
          && getAfter(/databases/$(database)/documents/farms/$('submitted-' + id)).data.lng == resource.data.proposedLng
        ));
      allow delete: if false;
    }
    // V3.3.89: Administrator-only, immutable human duplicate adjudication.
    // A linked-existing decision closes the pending application in the SAME
    // transaction; a distinct-operator decision retains it for separate approval.
    match /submissionResolutions/{submissionId} {
      allow get, list: if admin();
      allow create: if admin()
        && !exists(/databases/$(database)/documents/submissionResolutions/$(submissionId))
        && request.resource.data.keys().hasAll(['submissionId','mode','farmUid','matchedUids','reason','adminUid','reviewedAt'])
        && request.resource.data.keys().hasOnly(['submissionId','mode','farmUid','matchedUids','reason','adminUid','reviewedAt'])
        && request.resource.data.submissionId == submissionId
        && request.resource.data.mode in ['link_existing','distinct']
        && request.resource.data.farmUid is string
        && request.resource.data.farmUid.size() > 0
        && request.resource.data.farmUid.size() <= 100
        && exists(/databases/$(database)/documents/farms/$(request.resource.data.farmUid))
        && request.resource.data.matchedUids is list
        && request.resource.data.matchedUids.size() > 0
        && request.resource.data.matchedUids.size() <= 20
        && request.resource.data.farmUid in request.resource.data.matchedUids
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && exists(/databases/$(database)/documents/farmSubmissions/$(submissionId))
        && get(/databases/$(database)/documents/farmSubmissions/$(submissionId)).data.status == 'pending'
        && (request.resource.data.mode == 'distinct'
          || (getAfter(/databases/$(database)/documents/farmSubmissions/$(submissionId)).data.status == 'rejected'
            && getAfter(/databases/$(database)/documents/farmSubmissions/$(submissionId)).data.reviewedBy == request.auth.uid));
      allow update, delete: if false;
    }
    // V3.3.96: append-only proof of manual historical review.
    // NOT an approval lock, not a farm mutation, and not evidence of
    // parcel uniqueness. This preserves existing approval protections.
    match /legacyLockReviews/{farmId} {
      allow get, list: if admin();
      allow create: if admin()
        && !exists(/databases/$(database)/documents/legacyLockReviews/$(farmId))
        && exists(/databases/$(database)/documents/farms/$(farmId))
        && !exists(/databases/$(database)/documents/deletedFarms/$(farmId))
        && !farmId.matches('^submitted-.*$')
        && request.resource.data.keys().hasAll(['farmUid','farmName','farmVersion','parcelKey','reason','reviewerUid','reviewedAt','reviewType'])
        && request.resource.data.keys().hasOnly(['farmUid','farmName','farmVersion','parcelKey','reason','reviewerUid','reviewedAt','reviewType'])
        && request.resource.data.farmUid == farmId
        && request.resource.data.farmName == get(/databases/$(database)/documents/farms/$(farmId)).data.name
        && request.resource.data.farmVersion == get(/databases/$(database)/documents/farms/$(farmId)).data.version
        && !get(/databases/$(database)/documents/farms/$(farmId)).data.keys().hasAny(['approvalLockId'])
        && request.resource.data.parcelKey == get(/databases/$(database)/documents/farms/$(farmId)).data.get('auditParcelKey','')
        && request.resource.data.parcelKey is string && request.resource.data.parcelKey.size() <= 160
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 500
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewType == 'legacy_history_only';
      allow update, delete: if false;
    }
    // V3.4.02: administrator-only append-only evidence versions.
    // Not a farm approval, not a parcel lock; never overwrite history.
    match /legacyEvidenceArchives/{archiveId} {
      allow get, list: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasAll(['farmUid','farmVersion','reviewerUid','signature','source','finding','note','stage','evidenceAt','archivedAt'])
        && request.resource.data.keys().hasOnly(['farmUid','farmVersion','reviewerUid','signature','source','finding','note','stage','evidenceAt','archivedAt'])
        && request.resource.data.farmUid is string && request.resource.data.farmUid.size() > 0 && request.resource.data.farmUid.size() <= 100
        && request.resource.data.farmVersion is int && request.resource.data.farmVersion >= 1
        && exists(/databases/$(database)/documents/farms/$(request.resource.data.farmUid))
        && get(/databases/$(database)/documents/farms/$(request.resource.data.farmUid)).data.version == request.resource.data.farmVersion
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.signature is string && request.resource.data.signature.size() > 0 && request.resource.data.signature.size() <= 1600
        && request.resource.data.source in ['aerial','site','documents','combined']
        && request.resource.data.finding in ['confirmed','needsEvidence','conflict']
        && request.resource.data.note is string && request.resource.data.note.size() >= 10 && request.resource.data.note.size() <= 500
        && request.resource.data.stage in ['todo','checking','evidence','reviewed']
        && request.resource.data.evidenceAt is string && request.resource.data.evidenceAt.size() <= 50
        && request.resource.data.archivedAt == request.time;
      allow update, delete: if false;
    }
    match /suggestions/{suggestionId} {
      allow get: if admin() || (contributor() && resource.data.submittedBy == request.auth.uid);
      allow list: if admin() || (contributor() && resource.data.submittedBy == request.auth.uid);
      allow create: if contributor() && validSuggestion(request.resource.data)
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && exists(/databases/$(database)/documents/farms/$(request.resource.data.farmUid))
        && get(/databases/$(database)/documents/farms/$(request.resource.data.farmUid)).data.version == request.resource.data.baseVersion;
      allow update: if admin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'rejected' || (
          getAfter(/databases/$(database)/documents/farms/$(resource.data.farmUid)).data.approvedSuggestionId == suggestionId
          && getAfter(/databases/$(database)/documents/farms/$(resource.data.farmUid)).data.version == resource.data.baseVersion + 1
        ));
      allow delete: if false;
    }
    // V3.3.46: cloud copies of human review. This is NOT a formal farm.
    // Each authenticated user owns their copy; only the owner or an admin
    // can read. Query must constrain ownerUid for ordinary users.
    function validSharedAudit(d) {
      return d.keys().hasAll(['key','lat','lng','decision','year','source','note','recordUid','promotedToUid','ownerUid','updatedAt'])
        && d.keys().hasOnly(['key','lat','lng','decision','year','source','note','recordUid','promotedToUid','ownerUid','updatedAt'])
        && d.key is string && d.key.size()>0 && d.key.size()<=160
        && d.decision in ['pig','maybe','other','defer']
        && d.year in [3,4]
        && d.source in ['official','manual','tile','offline']
        && d.note is string && d.note.size()<=500
        && d.recordUid is string && d.recordUid.size()<=100
        && d.promotedToUid is string && d.promotedToUid.size()<=100
        && d.ownerUid is string && d.ownerUid.size()>0
        && d.updatedAt == request.time && allowedCoords(d,'lat','lng')
        && d.lat != null;
    }
    match /sharedAudits/{id} {
      allow get, list: if admin() || (contributor() && resource.data.ownerUid == request.auth.uid);
      allow create: if contributor() && validSharedAudit(request.resource.data)
        && id.matches('^audit-' + request.auth.uid + '-[0-9a-z]+$')
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if contributor() && validSharedAudit(request.resource.data)
        && id.matches('^audit-' + request.auth.uid + '-[0-9a-z]+$')
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if contributor() && resource.data.ownerUid == request.auth.uid;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
